{
  "name": "@ecuabyte/cortex-mcp-server",
  "version": "0.9.3",
  "mcpName": "io.github.EcuaByte-lat/cortex",
  "description": "MCP server exposing Cortex engineering state and handoffs to coding agents",
  "type": "module",
  "bin": {
    "cortex-mcp": "./dist/mcp-server.js"
  },
  "main": "./dist/mcp-server.js",
  "scripts": {
    "build": "bun build src/mcp-server.ts --outdir dist --target bun --format esm",
    "dev": "bun run --watch src/mcp-server.ts",
    "start": "bun run dist/mcp-server.js",
    "typecheck": "bunx tsc --noEmit",
    "generate-config": "bun run src/mcp-server.ts generate-config"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "coding-agents",
    "engineering-state",
    "handoff",
    "verification",
    "provenance",
    "context",
    "claude",
    "copilot"
  ],
  "author": "EcuaByte <hello@ecuabyte.com> (https://github.com/EcuaByte-lat)",
  "license": "MIT",
  "homepage": "https://github.com/EcuaByte-lat/Cortex#readme",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EcuaByte-lat/Cortex.git",
    "directory": "packages/mcp-server"
  },
  "dependencies": {
    "@ecuabyte/cortex-core": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
